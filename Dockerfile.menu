FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Copy entire repo so all declared modules are present
COPY . .
RUN mvn -pl restaurant-menu -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/restaurant-menu/target/restaurant-menu-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8082
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
