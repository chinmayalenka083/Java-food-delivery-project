FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Build only the payment module plus its dependencies
COPY . .
RUN mvn -pl payment -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/payment/target/payment-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8085
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
