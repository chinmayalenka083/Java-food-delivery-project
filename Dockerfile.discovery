FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Copy full repo so all modules referenced in the parent POM are present
COPY . .
RUN mvn -pl discovery -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/discovery/target/discovery-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8761
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
