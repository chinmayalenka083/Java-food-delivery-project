FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Copy entire repo so parent POM modules exist during build
COPY . .
RUN mvn -pl auth-user -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/auth-user/target/auth-user-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8081
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
