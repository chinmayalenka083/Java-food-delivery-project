FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Build only the delivery-partner module plus its dependencies
COPY . .
RUN mvn -pl delivery-partner -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/delivery-partner/target/delivery-partner-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8087
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
