FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
# Build only the notification module plus its dependencies
COPY . .
RUN mvn -pl notification -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/notification/target/notification-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_OPTS=""
EXPOSE 8086
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
